{
  "name": "hilo-nuestro",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB=hilo-nuestro --r2=FILES --port 8788",
    "db:local": "wrangler d1 execute hilo-nuestro --local --file=schema.sql",
    "db:remote": "wrangler d1 execute hilo-nuestro --remote --file=schema.sql",
